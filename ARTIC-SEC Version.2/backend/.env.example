APP_NAME=ARTIC-Sec
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-64-char-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_ENABLED=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/articsec
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mitre_attack
REDIS_URL=redis://localhost:6379/0

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ALERT_TOPIC=security-alerts
KAFKA_GROUP_ID=articsec-consumers

LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

CORS_ORIGINS=http://localhost:3000
WS_HEARTBEAT_SECONDS=30
ALERT_STREAM_INTERVAL_SECONDS=2.0
MAX_ACTIONS_PER_HOUR=10

# --- Auth / RBAC (JWT already scaffolded; flip AUTH_ENABLED=true to require login) ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- SOAR playbooks ---
# When true, low-risk actions (MONITOR/RATE_LIMIT) auto-execute; anything
# high/critical or targeting an internal asset always requires human approval
# regardless of this flag (see requires_human_approval in response_agent.py).
AUTO_EXECUTE_LOW_RISK=true
# Optional: paste a Slack "Incoming Webhook" URL to get action notifications.
SLACK_WEBHOOK_URL=

# --- Live threat intelligence enrichment (optional; recon agent degrades
# gracefully to MITRE-only enrichment if these are blank or unreachable) ---
THREAT_INTEL_ENABLED=true
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_TIMEOUT_SECONDS=3.0

SYNTHETIC_ALERTS_PATH=../data/synthetic/synthetic_alerts.csv
MITRE_TECHNIQUES_PATH=../data/mitre-attack/mitre_techniques.json
MITRE_TACTICS_PATH=../data/mitre-attack/mitre_tactics.json
MITRE_RELATIONSHIPS_PATH=../data/mitre-attack/mitre_relationships.json
CIC_DATA_DIR=../data/cic-ids2017
MODEL_DIR=app/ml/models
